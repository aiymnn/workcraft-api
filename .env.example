# Backend-only overrides. Compose passes the shared values from the root .env.
# Copy to backend/.env for local (non-Docker) runs. Never commit real secrets.

APP_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3307
DB_NAME=workcraft
DB_USER=workcraft
DB_PASSWORD=change_me

CORS_ORIGIN=http://localhost:5173

JWT_SECRET=change_this_to_a_long_random_secret_min_32
JWT_EXPIRES_IN=1h

# Seeds (also set in root .env for Docker). Studio Owner is sole OWNER;
# STUDIO_COADMIN_* is studio ADMIN coworker. SYSTEM_ADMIN_* is platform-only (not on Team).
SYSTEM_ADMIN_NAME=System Admin
SYSTEM_ADMIN_EMAIL=admin@workcraft.local
SYSTEM_ADMIN_PASSWORD=change_me
STUDIO_OWNER_NAME=Adam Syamil
STUDIO_OWNER_EMAIL=adam@workcraft.local
STUDIO_OWNER_PASSWORD=password
STUDIO_COADMIN_NAME=Farhana Aziera
STUDIO_COADMIN_EMAIL=farhana@workcraft.local
STUDIO_COADMIN_PASSWORD=password

# Origin of the client-facing web app — used to build public quote / portal links.
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Outbound email. Sending stays disabled until host + user + pass are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (Calendar sync + Drive receipts). Account dialogs say
# "Not available yet" until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/account/oauth/google/callback

# AES-256-GCM key for provider tokens at rest. Falls back to JWT_SECRET when
# unset; rotating either value makes stored Google tokens unreadable.
TOKEN_ENC_KEY=

# CHIP online payments. Portal checkout stays disabled until all three are set.
CHIP_BRAND_ID=
CHIP_API_KEY=
CHIP_WEBHOOK_SECRET=
